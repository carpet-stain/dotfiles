# shellcheck shell=bash
source_env_if_exists .envrc.local

# use_github_token (direnv/lib/, #195) — see AGENTS.md's Credentials
# section. Guard: fail closed loudly if the lib isn't deployed yet.
if declare -f use_github_token >/dev/null 2>&1; then
  use_github_token
else
  log_error "use_github_token undefined — run macos/deploy.zsh or linux/deploy.sh first (#195)"
  export GH_TOKEN=vended-unavailable-see-453
  export GITHUB_TOKEN="$GH_TOKEN"
fi
