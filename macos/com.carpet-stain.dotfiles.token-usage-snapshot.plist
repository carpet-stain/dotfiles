<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.carpet-stain.dotfiles.token-usage-snapshot</string>
	<!--
	 No absolute paths: launchd plists can't expand $HOME, and this file is
	 symlinked as-is (deploy.zsh's link_configs), not templated per machine.
	 zsh always sources .zshenv (even non-interactively), which puts
	 $HOME/.local/bin on PATH -- snapshot-token-usage (the symlinked script)
	 resolves from there. See dotfiles#518, dotfiles#542.
	-->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<string>snapshot-token-usage</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
