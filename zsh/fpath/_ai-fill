#!/usr/bin/env zsh

# ZLE widget (Alt+I, #555 + #556 + #585): fills BUFFER from aichat's
# shell-fill role, grounded on a read-only probe when the buffer matches a
# known tool (git checkout-family, git commit, docker, kubectl, brew, gh) or,
# for anything else, a bare ecosystem-marker sniff. BUFFER/CURSOR change only
# on a clean, non-empty reply. A probe timeout or failure drops just that probe
# and falls back to a plain, ungrounded fill — it never uses a killed
# command's output. A guard failure, an aichat timeout, or Ctrl-C anywhere
# leaves the typed line exactly as it was. Timeouts run through
# _ai-fill-bounded (fpath/_ai-fill-bounded) — a second function in this
# file would break autoload's first-call dispatch.
_ai-fill() {
  emulate -L zsh
  setopt local_options extended_glob localtraps

  if [[ -z ${BUFFER//[[:space:]]/} ]]; then
    zle -M 'ai-fill: nothing to fill'
    zle beep
    return 0
  fi

  if (( ! ${+commands[aichat]} )); then
    zle -M 'ai-fill: aichat not installed'
    zle beep
    return 0
  fi

  # Same Keychain resolution as scripts/aichat-pane.sh — see AGENTS.md's
  # OpenRouter section. This role file carries no key.
  local api_key=${OPENROUTER_API_KEY:-$(security find-generic-password -s openrouter-api-key -a openrouter -w 2>/dev/null)}
  if [[ -z $api_key ]]; then
    zle -M 'ai-fill: no OpenRouter key — see AGENTS.md Credentials'
    zle beep
    return 0
  fi

  local prompt=$BUFFER reply rc
  zle -M 'ai-fill: thinking…'

  # Strip leading sudo/WORD=VALUE pairs in any order (#556) so `sudo FOO=bar
  # docker ps` still routes; sudo with flags or unbalanced quoting falls
  # through to plain fill below (acceptable degradation).
  local -a words
  words=("${(z)BUFFER}")
  local stripped=1
  while (( stripped )); do
    stripped=0
    if (( $#words )) && [[ ${words[1]} == [a-zA-Z_][a-zA-Z0-9_]#=* ]]; then
      shift words
      stripped=1
    elif [[ ${words[1]} == sudo ]]; then
      shift words
      stripped=1
    fi
  done
  local lead="${words[1]} ${words[2]}"

  # Per-probe watchdog (#556): each command backgrounded bare, never
  # piped/grouped — a compound job orphans a stuck stage on kill. A timed-
  # out sub-command's output is never emitted into probe_out (may be
  # partial); 130 aborts the whole widget below.
  local probe_out probe_rc=0
  case $lead in
    'git checkout' | 'git switch' | 'git merge' | 'git rebase')
      probe_out=$(
        TRAPINT() { _ai-fill-bounded-terminate; exit 130 }
        _ai-fill-bounded 10 git branch -a
        (( $? == 0 )) && print -r -- "$_ai_fill_bounded_output"
        exit 0
      )
      probe_rc=$?
      ;;
    'git commit')
      probe_out=$(
        TRAPINT() { _ai-fill-bounded-terminate; exit 130 }
        _ai-fill-bounded 5 git diff --cached --name-status
        if (( $? == 0 )); then
          # Cap before combining with log lines — a single post-slice on
          # the joined output would starve the log if diff alone hit it.
          local -a difflines
          difflines=("${(@f)_ai_fill_bounded_output}")
          (( $#difflines > 50 )) && difflines[51,-1]=()
          print -r -- "${(F)difflines}"
        fi
        _ai-fill-bounded 5 git log -5 --oneline
        (( $? == 0 )) && print -r -- "$_ai_fill_bounded_output"
        exit 0
      )
      probe_rc=$?
      ;;
    'docker '*)
      probe_out=$(
        TRAPINT() { _ai-fill-bounded-terminate; exit 130 }
        _ai-fill-bounded 5 docker ps
        (( $? == 0 )) && print -r -- "$_ai_fill_bounded_output"
        if [[ -f docker-compose.yml || -f docker-compose.yaml || -f compose.yml || -f compose.yaml ]]; then
          _ai-fill-bounded 5 docker compose ps
          (( $? == 0 )) && print -r -- "$_ai_fill_bounded_output"
        fi
        exit 0
      )
      probe_rc=$?
      ;;
    'kubectl exec' | 'kubectl logs')
      probe_out=$(
        TRAPINT() { _ai-fill-bounded-terminate; exit 130 }
        _ai-fill-bounded 20 kubectl get pods
        (( $? == 0 )) && print -r -- "$_ai_fill_bounded_output"
        exit 0
      )
      probe_rc=$?
      ;;
    'kubectl delete')
      # $lead is only the first two words, so an unrestricted arm would
      # ground a deployment/service/namespace deletion with pod names,
      # which don't apply and could mislead (#585 plan review) — only
      # probe when the third word actually names a pod.
      if [[ ${words[3]} == pod || ${words[3]} == pods ]]; then
        probe_out=$(
          TRAPINT() { _ai-fill-bounded-terminate; exit 130 }
          _ai-fill-bounded 20 kubectl get pods
          (( $? == 0 )) && print -r -- "$_ai_fill_bounded_output"
          exit 0
        )
        probe_rc=$?
      fi
      ;;
    'brew '*)
      probe_out=$(
        TRAPINT() { _ai-fill-bounded-terminate; exit 130 }
        _ai-fill-bounded 10 brew leaves
        (( $? == 0 )) && print -r -- "$_ai_fill_bounded_output"
        exit 0
      )
      probe_rc=$?
      ;;
    'gh pr')
      probe_out=$(
        TRAPINT() { _ai-fill-bounded-terminate; exit 130 }
        _ai-fill-bounded 15 gh pr list --limit 10
        (( $? == 0 )) && print -r -- "$_ai_fill_bounded_output"
        exit 0
      )
      probe_rc=$?
      ;;
    'gh issue')
      probe_out=$(
        TRAPINT() { _ai-fill-bounded-terminate; exit 130 }
        _ai-fill-bounded 15 gh issue list --limit 10
        (( $? == 0 )) && print -r -- "$_ai_fill_bounded_output"
        exit 0
      )
      probe_rc=$?
      ;;
    *)
      # No subprocess, no watchdog needed — pure local file-existence
      # checks can't hang. Deliberately just an enum (#585 plan review:
      # a raw cwd listing is $PWD contents, which ADR-0045 forbids
      # sending; a --help allowlist adds request bytes for
      # machine-independent public docs, not specific grounding).
      local -a markers
      [[ -f package.json ]] && markers+=(node)
      [[ -f pyproject.toml || -f requirements.txt ]] && markers+=(python)
      [[ -f Cargo.toml ]] && markers+=(rust)
      [[ -f go.mod ]] && markers+=(go)
      [[ -f Gemfile ]] && markers+=(ruby)
      (( $#markers )) && probe_out="ecosystem: ${(j:, :)markers}"
      ;;
  esac

  if (( probe_rc == 130 )); then
    zle -M 'ai-fill: no reply'
    zle beep
    zle reset-prompt
    return 0
  fi

  # Bound probe output (ADR-0045, #556): ~55 lines, sliced here rather
  # than piped through `head` inside the watchdog (same orphan risk).
  if [[ -n $probe_out ]]; then
    local -a outlines
    outlines=("${(@f)probe_out}")
    (( $#outlines > 55 )) && probe_out="${(F)outlines[1,55]}"
  fi

  local arg=$prompt
  if [[ -n ${probe_out//[[:space:]]/} ]]; then
    arg=$'## Context (read-only, for grounding — do not echo)\n'"$probe_out"$'\n\n## Intent\n'"$prompt"
  fi

  # Watchdog, not `timeout`(1) — no new coreutils dependency (#555).
  # _ai-fill-bounded, not `sleep N; kill $watchdog` — that orphans sleep(1)
  # and hangs every successful call for up to the full timeout (#556).
  reply=$(
    TRAPINT() { _ai-fill-bounded-terminate; exit 130 }
    OPENROUTER_API_KEY=$api_key OPENAI_COMPATIBLE_API_KEY=$api_key \
      _ai-fill-bounded 150 aichat --role shell-fill --no-stream -- "$arg"
    local brc=$?
    (( brc == 0 )) && print -r -- "$_ai_fill_bounded_output"
    exit $brc
  )
  rc=$?

  if (( rc != 0 )) || [[ -z ${reply//[[:space:]]/} ]]; then
    zle -M 'ai-fill: no reply'
    zle beep
    zle reset-prompt
    return 0
  fi

  # Sanitize: strip ANSI escapes, fences, an echoed Context block in full
  # (#556 — a model that echoes the header may echo its content too),
  # leading `$`/prompt marks, trailing prose — first line only.
  reply=${reply//$'\e'\[[0-9;]#[a-zA-Z]/}
  local -a lines cmd_lines
  lines=("${(@f)reply}")
  local line in_context=0
  for line in $lines; do
    if [[ $line == '## Context'* ]]; then
      in_context=1
      continue
    fi
    if (( in_context )); then
      [[ $line == '## Intent'* ]] && in_context=0
      continue
    fi
    [[ $line == '```'* ]] && continue
    [[ -z ${line//[[:space:]]/} ]] && continue
    cmd_lines+=("$line")
  done

  local cmd=${cmd_lines[1]}
  cmd=${cmd##[[:space:]]#}
  cmd=${cmd##\$[[:space:]]#}
  cmd=${cmd%%[[:space:]]#}

  if [[ -z $cmd ]]; then
    zle -M 'ai-fill: no reply'
    zle beep
    zle reset-prompt
    return 0
  fi

  BUFFER=$cmd
  CURSOR=$#BUFFER
  zle reset-prompt
}
